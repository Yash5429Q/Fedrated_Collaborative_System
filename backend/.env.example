# CYBER-20 Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ────────────────────────────────────────────
APP_NAME="CYBER-20 Federated Threat Detection"
APP_VERSION="0.1.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true

# ── Server ─────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000

# ── Database ────────────────────────────────────────────────
# SQLite (default for development). PostgreSQL URI accepted for production.
DATABASE_URL="sqlite+aiosqlite:///./cyber20.db"

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173"

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL="INFO"                   # DEBUG | INFO | WARNING | ERROR

# ── Federated Learning (not yet connected) ──────────────────
# FL_SERVER_HOST="localhost"
# FL_SERVER_PORT=9090

# ── ML Pipeline (not yet connected) ─────────────────────────
# MODEL_CHECKPOINT_DIR="./checkpoints"
# DATASET_PATH="./data/dataset.csv"
